# ============================================================================
# Nodes Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and customize for your deployment
# Most settings have sensible defaults and can be omitted

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment mode: development, production
NODES_ENVIRONMENT=development

# Enable debug mode (verbose logging, CORS for localhost)
NODES_DEBUG=false

# Server configuration
NODES_HOST=0.0.0.0
NODES_PORT=8000

# Database file path (relative to backend/ or absolute path)
NODES_DATABASE_PATH=data/nodes.db

# CORS (comma-separated list of allowed origins, or use NODES_CORS_ORIGINS for JSON array)
NODES_CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000"]

# ============================================================================
# AUTHENTICATION SETTINGS (Optional)
# ============================================================================
# Authentication is OPTIONAL. When disabled (default), platform runs in
# single-user mode with no login required.

# Enable authentication (default: false)
NODES_AUTH_ENABLED=false

# SSO Provider: duo, okta, azure, google
NODES_SSO_PROVIDER=duo

# Display name for SSO provider (shown in UI)
NODES_SSO_DISPLAY_NAME=Duo Security

# ============================================================================
# OIDC/OAuth CONFIGURATION
# ============================================================================

# OAuth Client Credentials (get from your SSO provider)
NODES_SSO_CLIENT_ID=your_client_id_here
NODES_SSO_CLIENT_SECRET=your_client_secret_here

# Redirect URI - must match your SSO app configuration
NODES_SSO_REDIRECT_URI=http://localhost:8000/api/auth/callback

# OAuth Scopes (space-separated)
NODES_SSO_SCOPES=openid email profile

# OIDC Endpoints (Optional - Auto-configured for known providers)
# NODES_SSO_AUTHORIZATION_URL=https://...
# NODES_SSO_TOKEN_URL=https://...
# NODES_SSO_USERINFO_URL=https://...

# ============================================================================
# JWT TOKEN CONFIGURATION
# ============================================================================

# JWT Secret Key (REQUIRED if auth enabled) - Generate with: openssl rand -hex 32
NODES_JWT_SECRET_KEY=your_secret_key_here

# Token expiration
NODES_ACCESS_TOKEN_EXPIRE_MINUTES=15
NODES_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# AUDIT LOGGING
# ============================================================================

# Enable audit logging (default: true when auth enabled)
NODES_AUDIT_LOG_ENABLED=true

# Retention period in days
NODES_AUDIT_LOG_RETENTION_DAYS=90

# Maximum audit log size in MB
NODES_AUDIT_LOG_MAX_SIZE_MB=100

# ============================================================================
# SSO HEALTH MONITORING
# ============================================================================

# Fallback mode: require_sso (read-only) or fallback_anonymous
NODES_SSO_FALLBACK_MODE=require_sso

# Default author when in fallback mode
NODES_SSO_FALLBACK_DEFAULT_AUTHOR=system

# ============================================================================
# See .env.example for detailed documentation and configuration examples
# ============================================================================
