# Nodes Configuration
# Copy this file to .env and adjust as needed

# Application
NODES_DEBUG=false
NODES_HOST=0.0.0.0
NODES_PORT=8000

# Database
NODES_DATABASE_PATH=data/nodes.db

# CORS (comma-separated list of allowed origins)
NODES_CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000"]
